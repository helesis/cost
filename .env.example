# Cost Analysis API — örnek ortam değişkenleri
# Kopyalayın: cp .env.example .env  ardından değerleri düzenleyin.

# ── Sunucu ─────────────────────────────────────────────────────────────────────
PORT=3010

# ── Uygulama girişi (ilk kurulumda tablo boşsa otomatik oluşturulur) ─────────
# COST_COOKIE_SECRET=uzun-rastgele-bir-deger
# COST_BOOTSTRAP_ADMIN_USER=admin
# COST_BOOTSTRAP_ADMIN_PASSWORD=guclu-parola
# production | development | boş (geliştirme varsayılanı)
NODE_ENV=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=voyagestars
DB_USER=postgres
DB_PASSWORD=postgres

# ── Ollama (ürün sınıflandırma + USDA çeviri/onay) ───────────────────────────
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=gemma2:27b
OLLAMA_USDA_MODEL=qwen2.5:32b
OLLAMA_TIMEOUT_SEC=180

# ── USDA / besin (nutrition_service ile) ───────────────────────────────────
USDA_API_KEY=
USDA_FOOD_DATA_CENTRAL_KEY=
NUTRITION_SERVICE_URL=http://127.0.0.1:3012
